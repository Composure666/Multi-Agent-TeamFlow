# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# --- 凭据类文件：宁可多拦 ---
# 私钥 / 证书 / 密钥库
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
*.crt
*.cer
# 各类 CLI / 云服务的凭据文件
.netrc
_netrc
.htpasswd
.htaccess
credentials.json
service-account*.json
.aws/
.ssh/
.kube/
.docker/config.json
.npmrc
.pypirc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# 常见的「本地覆盖」命名，docker-compose / vercel 等会读
*.local
!*.local.example
.envrc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Multi-Agent TeamFlow runtime data
/.agenthub-data/
/.agenthub-data-e2e/
/.tmp/
/drizzle/

# Playwright report
/playwright-report/
/test-results/

# Electron build outputs
/dist-electron/
/release/

# 桌面端安装包：体积在百 MB 量级，绝不进版本库、也不进部署压缩包。
# 目录本身要保留（.gitkeep），因为 Next 的 standalone 组装会把 public/ 整个拷过去。
# 发布方式见 deploy/RUNBOOK.md「安装包发布」一节。
/public/downloads/*
!/public/downloads/.gitkeep

# Mobile app build outputs
/apps/mobile/dist/

# IDE
.vscode/
.idea/

# Local tooling caches / workspaces (developer-specific, not source)
/.codebuddy/
/.workbuddy/
/.pnpm-store/

# Agent / debug tooling scratch outputs (NOT source, hidden dirs)
# 注意:必须写完整目录名带前导斜杠才能在仓库根匹配到隐藏目录
/.playwright-cli/
/.tmp-probe/
/.vitest-result/

# Project deliverables raw exports
/deliverables/
/output/

# Root-level Electron runtime spillover
/debug.log
/agenthub-dev.log

# Local git backup created during ref-corruption recovery
/.git.bak/

# Local agent scratch dir (safety net)
/workspaces/
/.vitest-result.txt
