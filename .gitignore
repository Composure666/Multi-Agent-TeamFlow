# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AgentHub runtime data
/.agenthub-data/
/.agenthub-data-e2e/
/.tmp/
/drizzle/

# Playwright report
/playwright-report/
/test-results/

# Electron build outputs
/dist-electron/
/release/

# Mobile app build outputs
/apps/mobile/dist/

# IDE
.vscode/
.idea/

# Local tooling caches / workspaces (developer-specific, not source)
/.codebuddy/
/.workbuddy/
/.pnpm-store/

# Agent / debug tooling scratch outputs (NOT source, hidden dirs)
# 注意:必须写完整目录名带前导斜杠才能在仓库根匹配到隐藏目录
/.playwright-cli/
/.tmp-probe/
/.vitest-result/

# Project deliverables raw exports
/deliverables/
/output/

# Root-level Electron runtime spillover
/debug.log

# Local git backup created during ref-corruption recovery
/.git.bak/

# Local agent scratch dir (safety net)
/workspaces/
