# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AgentHub runtime data
/.agenthub-data/
/.agenthub-data-e2e/
/.tmp/
/drizzle/

# Playwright (project-bundled artifacts; debug outputs at root only if a workspace keeps them)
/playwright-report/
/test-results/

# Electron build outputs
/dist-electron/
/release/

# Mobile app build outputs
/apps/mobile/dist/

# IDE
.vscode/
.idea/

# Local tooling caches / workspaces (developer-specific, not source)
/.codebuddy/
/.workbuddy/
/.pnpm-store/

# Agent / debug tooling scratch outputs (NOT source)
/.playwright-cli/        # playwright server console + page yml snapshots
/.tmp-probe/            # temporary diagnostic probes
/.vitest-result/        # ad-hoc vitest artifacts
/deliverables/          # one-off briefs (the report content lives in md inside src/, deliverables/ is for raw exports only)
/output/                # imagegen / playwright / matplotlib one-off images

# Root-level debug log (Electron runtime spillover)
/debug.log

# Local git backup created during ref-corruption recovery
/.git.bak/

# Local agent-hub data scratch dirs (safety net)
/workspaces/
