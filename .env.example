# Local API keys for AI providers.
# Copy this file to .env.local and fill values locally.
# Never commit .env.local or real tokens.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# 火山方舟 (Volcano Ark) — 走豆包多模态模型用这个
ARK_API_KEY=

# Optional provider endpoint override. Keep personal gateway URLs in .env.local.
# ANTHROPIC_BASE_URL=

# Optional: prompt optimization model. Supported: deepseek-v4-flash, deepseek-v4-pro.
# PROMPT_OPTIMIZE_MODEL=deepseek-v4-flash

# 历史遗留（已失效）：这两项在代码里没有任何读取点（全仓 grep 命中 0 处）。
# Orchestrator 的模型现在取 agent 行自身的 model 配置，不再有 env 覆盖入口。
# 保留仅为兼容旧 .env.local，传不传都不生效。
# ORCHESTRATOR_PROVIDER=anthropic
# ORCHESTRATOR_MODEL_ID=claude-opus-4-7

# Optional: Aliyun OSS — stable remote storage for image artifacts.
# All four must be set to enable OSS; otherwise images fall back to local storage.
# Fill in your *own* bucket / endpoint / credentials. Do NOT commit real values.
# OSS_BUCKET=your-bucket-name
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
#
# Using OSS for public image delivery? Set publicRead via the settings UI, and
# remember the bucket is world-readable — never upload private artifacts there.
